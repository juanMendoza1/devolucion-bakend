# Copiar como .env (en la raíz del proyecto) y completar. El archivo .env NO se versiona.
# También se pueden definir como variables de entorno del sistema/servidor.

DB_URL=jdbc:postgresql://localhost:5432/devoluciones_db
DB_USERNAME=
DB_PASSWORD=

# Clave HS256 en Base64 (mínimo 32 bytes). Generar con: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=86400000

# Orígenes del frontend permitidos, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Solo se usa al arrancar si el usuario admin inicial no existe. Dejar vacío después.
ADMIN_INITIAL_PASSWORD=
